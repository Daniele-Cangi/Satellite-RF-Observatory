# Satellite Intelligence System - Environment Configuration Example
# Copy this file to .env and fill with actual values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=satint
DB_USER=satint
DB_PASSWORD=your_secure_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Observer Location
LOCATION_LAT=55.6761
LOCATION_LON=12.5683
LOCATION_ALT=10.0

# TLE Sources
SPACETRACK_USERNAME=your_username
SPACETRACK_PASSWORD=your_password

# SDR Receiver
RECEIVER_ENABLED=true
RECEIVER_DEVICE=driver=rtlsdr

# Security
DEBUG=false
LOG_LEVEL=INFO
